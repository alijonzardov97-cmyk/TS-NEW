# Front door for the Tailscale address: everything is passed to the TS server except the admin
# area, which is reachable only locally (http://127.0.0.1:8080/admin on the server PC itself).
{
	admin off
	auto_https off
}

:8081 {
	@admin path /admin /admin/* /api/admin /api/admin/*
	respond @admin 404

	# The real client address is set here and nowhere else: whatever the client sent in these
	# headers is thrown away, so it cannot fake an address to dodge login limits.
	reverse_proxy ts:8080 {
		header_up -CF-Connecting-IP
		header_up -X-Real-IP
		header_up X-Forwarded-For {remote_host}
	}
}
